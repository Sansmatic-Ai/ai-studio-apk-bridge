{
  "manifest_version": 3,
  "name": "AI Studio APK Bridge",
  "version": "1.0.0",
  "description": "Lets Google AI Studio's \"Install via USB\" save the APK straight to this device. No PC or cable needed.",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "AI Studio APK Bridge",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://aistudio.google.com/*", "https://ai.studio/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://aistudio.google.com/*", "https://ai.studio/*"],
      "js": ["loader.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["https://aistudio.google.com/*", "https://ai.studio/*"]
    }
  ]
}